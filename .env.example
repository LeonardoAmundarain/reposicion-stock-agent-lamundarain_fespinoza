# Proveedor por defecto para conversar: gemini o claude. En el panel se puede cambiar.
LLM_PROVEEDOR=gemini

# Agrega la key del proveedor que uses. Estas keys van solo en .env, nunca en este archivo.
GOOGLE_API_KEY=tu_api_key_aqui
ANTHROPIC_API_KEY=tu_api_key_aqui
CLAUDE_MODEL=claude-opus-5-5
LLM_MODEL=gemini-3.6-flash
LLM_RESPALDO=gemini-3.5-flash-lite
# Modelos del panel: 4 de Claude y 7 de Gemini, definidos en config/settings.py.

# Datos reales de la empresa, incluidos con su autorización en data/reales.
# Las rutas pueden ser completas o relativas a la carpeta del proyecto.
FUENTE_DATOS=real
RUTA_VENTAS=data/reales/VENTA CAJAS, 15,16 Y 37.xlsx
RUTA_STOCK=data/reales/STOCK LOCALES 14, 15 Y 16.xlsx
# Para usar los datos simulados, cambia FUENTE_DATOS a simulado y borra las dos rutas.

# Con datos reales, el chat queda apagado salvo que lo autorices: envía al proveedor nombres de
# productos, stock y ventas en unidades. En el nivel gratuito, Google usa ese contenido para
# mejorar sus productos. El iniciador pregunta si quieres activarlo.
# PERMITIR_LLM_CON_DATOS_REALES=true
